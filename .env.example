# Local Environment Variables Template (.env.example)
# Copy this file to '.env' for local customization.
# Note: Never commit real credentials or production secrets to Git!

# Application Port & Host
PORT=8000
HOST=0.0.0.0
APP_VERSION=1.0.0

# Database Connection (MongoDB)
# - For running directly on your laptop: mongodb://localhost:27017/crypto_db
# - For running inside Docker Compose:  mongodb://mongodb:27017/crypto_db
MONGODB_URI=mongodb://localhost:27017/crypto_db

# Logging & Environment Mode
LOG_LEVEL=info
ENVIRONMENT=development
TESTING=false
